# ============================================================
# RescueGrid Backend Environment Configuration (.env.example)
# ============================================================

# Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Secret Key (Required for trusted backend operations & RPCs)
# CAUTION: Never expose this key in frontend code or client bundles.
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# Supabase Publishable / Anon Key (Used for public verification or client handshakes)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# Allowed Frontend Origins for CORS (Comma-separated list in production)
# Example: https://rescuegrid.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend Port (Defaults to 8000 if omitted)
PORT=8000

# Application Environment (development, staging, production)
ENVIRONMENT=development

