# ============================================================
# RescueGrid Backend Environment Configuration (.env.example)
# ============================================================

# Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Secret Key (Required for trusted backend operations & RPCs)
# CAUTION: Never expose this key in frontend code or client bundles.
SUPABASE_SECRET_KEY=sb_secret_your_service_role_key_here

# Supabase Publishable / Anon Key (Used for public verification or client handshakes)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# Allowed Frontend Origins for CORS (Comma-separated list)
# Default dev origins (localhost:3000, 3001, etc.) are always included in development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Backend Port (Defaults to 8010 to avoid Windows socket permission conflicts on port 8000)
PORT=8010

# Application Environment (development, staging, production)
ENVIRONMENT=development
