# ==========================================
# Smart Disaster Response - Git Ignore
# ==========================================

# Environment variables / secrets
.env
.env.*
!.env.example

# Backend
backend/.env
backend/venv/
backend/__pycache__/
backend/*.pyc

# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# Frontend environment files
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing
coverage/
.nyc_output/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/

# TypeScript build cache
*.tsbuildinfo

# Temporary files
*.tmp
*.temp