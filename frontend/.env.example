# ============================================================
# RescueGrid Frontend Environment Configuration (.env.example)
# ============================================================

# Supabase Project URL (Browser-accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous / Publishable Key (Browser-accessible; protected by PostgreSQL RLS)
# CAUTION: Never put service_role or secret keys in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# FastAPI Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

